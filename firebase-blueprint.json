  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserSafetyProfile" },
      "description": "Owner-isolated user safety profile."
    },
    "/emergency_dispatches/{dispatchId}": {
      "schema": { "$ref": "#/entities/EmergencyDispatch" },
      "description": "Owner and trusted-guardian scoped SOS cloud dispatches."
    },
    "/phone_directory/{phoneKey}": {
      "schema": { "$ref": "#/entities/PhoneDirectoryEntry" },
      "description": "Exact-key Phone ID directory for installed RakshaOne direct push discovery."
    },
    "/citizens/{citizenUid}": {
      "schema": { "$ref": "#/entities/CitizenProfile" },
      "description": "Citizen verification status, honor badge, and ledger-backed trust score."
    },
    "/citizen_verifications/{verificationId}": {
      "schema": { "$ref": "#/entities/CitizenVerification" },
      "description": "Peer-endorsed citizen KYC requests."
    },
    "/points_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/PointsLedgerEntry" },
      "description": "Append-only responder trust score ledger."
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/IncidentRecord" },
      "description": "Risk-classified safety incidents."
    },
    "/risk_assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/RiskAssessment" },
      "description": "Immutable risk intelligence engine evaluations."
    },
    "/emergency_escalation_events/{incidentId}": {
      "schema": { "$ref": "#/entities/EmergencyEscalationEvent" },
      "description": "Strictly policy-gated R3_CRITICAL police escalation records."
    },
    "/dispatch_attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/DispatchAttempt" },
      "description": "Audited dispatch channel attempt log."
    },
    "/delivery_receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/DeliveryReceipt" },
      "description": "Immutable delivery state receipts."
    },
    "/dossier_access/{tokenId}": {
      "schema": { "$ref": "#/entities/DossierAccess" },
      "description": "Token-gated web dossier snapshots for R3_CRITICAL 112 responder portal access."
    },
    "/hex_rescue_requests/{requestId}": {
      "schema": { "$ref": "#/entities/HexRescueRequest" },
      "description": "Active six-directional hexagonal rescue requests."
    },
    "/live_radar/{ownerUid}": {
      "schema": { "$ref": "#/entities/LiveRadarPin" },
      "description": "Real-time moving-pin radar location scoped to authorized guardians."
    },
    "/users/{userId}/trusted_contacts/{contactId}": {
      "schema": { "$ref": "#/entities/TrustedContactRecord" },
      "description": "Owner-isolated synced trusted circle contacts."
    },
    "/users/{userId}/ai_safety_state/{docId}": {
      "schema": { "$ref": "#/entities/AiSafetyStateRecord" },
      "description": "Owner-isolated Sovereign TFLite neural calibration profile."
    },
    "/evidence_vault/{chunkId}": {
      "schema": { "$ref": "#/entities/EvidenceVaultChunk" },
      "description": "Owner and trusted-guardian scoped chunked audio/photo/video evidence vault."
    }
  }
}
