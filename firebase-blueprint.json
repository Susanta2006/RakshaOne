        "mapsUrl": { "type": "string" },
        "locationSummary": { "type": "string" },
        "batteryPercent": { "type": "integer" },
        "medicalSummary": { "type": "string" },
        "evidenceSummary": { "type": "string" },
        "frontPhotoBase64": { "type": "string" },
        "rearPhotoBase64": { "type": "string" },
        "authorizedEmails": { "type": "array" },
        "authorizedPhones": { "type": "array" },
        "authorizedUids": { "type": "array" },
