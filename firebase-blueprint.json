{
  "entities": {
    "UserSafetyProfile": {
      "title": "UserSafetyProfile",
      "description": "Authenticated user's RakshaOne emergency safety and medical profile synced across sign-ins.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "allergies": { "type": "string" },
        "medicalNotes": { "type": "string" },
        "homeAddress": { "type": "string" },
        "workAddress": { "type": "string" },
        "autoSendSmsOnSos": { "type": "boolean" },
        "sirenBeaconEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "displayName", "email", "phone", "bloodGroup",
        "allergies", "medicalNotes", "homeAddress", "workAddress",
        "autoSendSmsOnSos", "sirenBeaconEnabled", "createdAt", "updatedAt"
      ]
    },
